{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit tag'|trans({}, 'page.bo.default') }}{% endblock %}
{% block body_testid %}page-edit-tag-page{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'page.bo.default') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('page_list') }}">{{ 'Pages'|trans({}, 'page.bo.default') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('page_tag_list') }}">{{ 'Tags'|trans({}, 'page.bo.default') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ page_tag }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="page-edit-tag-content">
        <h1 class="h3 mb-3">{{ 'Edit tag'|trans({}, 'page.bo.default') }} <small class="text-muted">#{{ page_tag_id }}</small></h1>

        {% if app.request.query.get('error') %}
            <div class="alert alert-danger">{{ app.request.query.get('error') }}</div>
        {% endif %}

        <div class="card">
            <div class="card-body">
                <form method="post" action="{{ path('page_tag_update_page', { tagId: page_tag_id }) }}" data-testid="page-tag-update-form">
                    {% include 'Page/include/tag-form-fields.html.twig' with {
                        form: tag_form,
                        tag_value: page_tag,
                        success_url: path('page_tag_list'),
                        error_url: path('page_tag_edit_page', { tagId: page_tag_id })
                    } only %}
                    <button type="submit" class="btn btn-primary" data-testid="page-tag-update-submit">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans({}, 'page.bo.default') }}
                    </button>
                    <a href="{{ path('page_tag_list') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans({}, 'page.bo.default') }}</a>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
