{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Create a new page'|trans({}, 'page.bo.default') }}{% endblock %}
{% block body_testid %}page-new-page{% endblock %}

{% set return_url = parent ? path('page_edit_page', { pageId: parent, current_tab: 'subPages' }) : path('page_list') %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, 'page.bo.default') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('page_list') }}">{{ 'Pages'|trans({}, 'page.bo.default') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Create a new page'|trans({}, 'page.bo.default') }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="page-new-content">
        <h1 class="h3 mb-3">{{ 'Create a new page'|trans({}, 'page.bo.default') }}</h1>

        {% if app.request.query.get('error') %}
            <div class="alert alert-danger">{{ app.request.query.get('error') }}</div>
        {% endif %}

        <div class="card">
            <div class="card-body">
                <form method="post" action="{{ path('page_create_page_action') }}" data-testid="page-create-form">
                    {% set prefix = create_form.vars.full_name %}
                    <input type="hidden" name="{{ prefix }}[_token]" value="{{ create_form._token.vars.value }}">
                    <input type="hidden" name="{{ prefix }}[parent]" value="{{ parent }}">
                    <input type="hidden" name="{{ prefix }}[success_url]" value="{{ return_url }}">
                    <input type="hidden" name="{{ prefix }}[error_url]" value="{{ parent ? path('page_new_page', { parent: parent }) : path('page_new_page') }}">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="page_title">{{ 'Page title'|trans({}, 'page.bo.default') }}</label>
                            <input type="text" class="form-control" id="page_title" name="{{ prefix }}[title]" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="page_code">{{ 'Page code'|trans({}, 'page.bo.default') }}</label>
                            <input type="text" class="form-control" id="page_code" name="{{ prefix }}[code]">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="page_type">{{ 'Page type'|trans({}, 'page.bo.default') }}</label>
                            <select class="form-select" id="page_type" name="{{ prefix }}[type]">
                                <option value="">{{ 'Choose a page type'|trans({}, 'page.bo.default') }}</option>
                                {% for choice in attribute(create_form, 'type').vars.choices %}
                                    {% if choice.value != '' %}
                                        <option value="{{ choice.value }}">{{ choice.label }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="page_block">{{ 'Thelia block'|trans({}, 'page.bo.default') }}</label>
                            <select class="form-select" id="page_block" name="{{ prefix }}[thelia-block]">
                                {% for choice in attribute(create_form, 'thelia-block').vars.choices %}
                                    {% if choice.value not in ['', '0'] %}
                                        <option value="{{ choice.value }}">{{ choice.label }}</option>
                                    {% else %}
                                        <option value="0">-- {{ 'Create a TheliaBlock'|trans({}, 'page.bo.default') }} --</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" for="page_description">{{ 'Description'|trans({}, 'page.bo.default') }}</label>
                            <textarea class="form-control wysiwyg" id="page_description" name="{{ prefix }}[description]" rows="6"></textarea>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" data-testid="page-create-submit">
                            <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans({}, 'page.bo.default') }}
                        </button>
                        <a href="{{ return_url }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans({}, 'page.bo.default') }}</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('wysiwyg.js', { location: 'page-new-js' }) }}
{% endblock %}
