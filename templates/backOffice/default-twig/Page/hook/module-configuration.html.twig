    <div class="card-header">
        <h2 class="card-title h5 mb-0">{{ 'Pages'|trans({}, 'page.bo.default') }}</h2>
    </div>
    <div class="card-body">
        <p>{{ 'This module lets you manage static pages from a dedicated administration section.'|trans({}, 'page.bo.default') }}</p>
