{# Shared pages table (used by the list page and the sub-pages tab) #}
<div class="table-responsive">
    <table class="table table-striped align-middle mb-0" data-testid="pages-table">
        <thead>
            <tr>
                <th>{{ 'Id'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Title'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Code'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Thelia block'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Url'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Tag'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Visible'|trans({}, 'page.bo.default') }}</th>
                <th>{{ 'Homepage'|trans({}, 'page.bo.default') }}</th>
                <th class="text-end">{{ 'Actions'|trans({}, 'page.bo.default') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for page in pages %}
                <tr data-testid="page-row-{{ page.id }}">
                    <td><a href="{{ path('page_edit_page', { pageId: page.id, current_tab: 'general' }) }}">{{ page.id }}</a></td>
                    <td><a href="{{ path('page_edit_page', { pageId: page.id, current_tab: 'general' }) }}">{{ page.title }}</a></td>
                    <td>{{ page.code }}</td>
                    <td><a href="{{ path('page_edit_page', { pageId: page.id, current_tab: 'block' }) }}">{{ page.block_group_title }}</a></td>
                    <td>{{ page.url }}</td>
                    <td>{{ page.tag }}</td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input page-toggle-visible" type="checkbox" data-page-id="{{ page.id }}" {{ page.visible ? 'checked' : '' }} data-testid="page-visible-{{ page.id }}">
                        </div>
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input page-toggle-home" type="checkbox" data-page-id="{{ page.id }}" {{ page.is_home ? 'checked' : '' }} data-testid="page-home-{{ page.id }}">
                        </div>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('page_edit_page', { pageId: page.id, current_tab: 'general' }) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'Edit this page'|trans({}, 'page.bo.default') }}">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                        <a href="{{ path('page_delete_page_action', { pageId: page.id }) }}" class="btn btn-sm btn-outline-danger" title="{{ 'Delete this page'|trans({}, 'page.bo.default') }}" data-testid="page-delete-{{ page.id }}">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9" class="text-muted text-center">{{ 'No page yet.'|trans({}, 'page.bo.default') }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
