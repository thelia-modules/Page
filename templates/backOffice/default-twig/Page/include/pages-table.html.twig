{# Shared pages table (used by the list page and the sub-pages tab) #}
{% set table_rows = [] %}
{% for page in pages %}
    {% set edit_url = path('page_edit_page', { pageId: page.id, current_tab: 'general' }) %}
    {% set visible_html %}
        <div class="form-check form-switch">
            <input class="form-check-input page-toggle-visible" type="checkbox"
                   data-page-id="{{ page.id }}"
                   {{ page.visible ? 'checked' : '' }}
                   data-testid="page-visible-{{ page.id }}">
        </div>
    {% endset %}
    {% set home_html %}
        <div class="form-check form-switch">
            <input class="form-check-input page-toggle-home" type="checkbox"
                   data-page-id="{{ page.id }}"
                   {{ page.is_home ? 'checked' : '' }}
                   data-testid="page-home-{{ page.id }}">
        </div>
    {% endset %}
    {% set action_html %}
        <div class="btn-group btn-group-sm" role="group" aria-label="{{ 'Row actions'|trans }}">
            <a href="{{ edit_url }}"
               class="btn btn-sm btn-outline-primary bo-action bo-action--edit"
               title="{{ 'Edit this page'|trans({}, 'page.bo.default') }}"
               aria-label="{{ 'Edit this page'|trans({}, 'page.bo.default') }}"
               data-testid="datatable-action-edit">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span class="visually-hidden">{{ 'Edit this page'|trans({}, 'page.bo.default') }}</span>
            </a>
            <a href="{{ path('page_delete_page_action', { pageId: page.id }) }}"
               class="btn btn-sm btn-outline-danger bo-action bo-action--delete"
               title="{{ 'Delete this page'|trans({}, 'page.bo.default') }}"
               aria-label="{{ 'Delete this page'|trans({}, 'page.bo.default') }}"
               data-testid="page-delete-{{ page.id }}">
                <i class="bi bi-trash" aria-hidden="true"></i>
                <span class="visually-hidden">{{ 'Delete this page'|trans({}, 'page.bo.default') }}</span>
            </a>
        </div>
    {% endset %}
    {% set table_rows = table_rows|merge([{
        'id':                '<a href="' ~ edit_url ~ '">' ~ page.id|e ~ '</a>',
        'title':             '<a href="' ~ edit_url ~ '">' ~ page.title|e ~ '</a>',
        'code':              page.code,
        'block_group_title': '<a href="' ~ path('page_edit_page', { pageId: page.id, current_tab: 'block' }) ~ '">' ~ page.block_group_title|e ~ '</a>',
        'url':               page.url,
        'tag':               page.tag,
        'visible':           visible_html,
        'is_home':           home_html,
        '_action':           action_html,
    }]) %}
{% endfor %}

{{ component('BoDataTable', {
    id: 'pages',
    columns: [
        column_html('id',                'Id'|trans({}, 'page.bo.default')),
        column_html('title',             'Title'|trans({}, 'page.bo.default')),
        column_text('code',              'Code'|trans({}, 'page.bo.default')),
        column_html('block_group_title', 'Thelia block'|trans({}, 'page.bo.default')),
        column_text('url',               'Url'|trans({}, 'page.bo.default')),
        column_text('tag',               'Tag'|trans({}, 'page.bo.default')),
        column_html('visible',           'Visible'|trans({}, 'page.bo.default'),  'center'),
        column_html('is_home',           'Homepage'|trans({}, 'page.bo.default'), 'center'),
        column_html('_action',           'Actions'|trans({}, 'page.bo.default'),  'end'),
    ],
    rows: table_rows,
    emptyMessage: 'No page yet.'|trans({}, 'page.bo.default'),
}) }}
