{% extends 'base.html.twig' %}

{% set pageData = getPageData() %}
{% set pageHTML = getTheliaBLocksRenderedContent(pageData.getVirtualColumn('block_group_content')|default('')) %}
{% set img = getImagesData({
	source_type: 'page',
	source_id: pageData.id,
	filters: 'default'
}) %}

{% block og_image %}{{ ((img|first)?.sources|first)?.url ?: parent()  }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block body %}
    <twig:Layouts:Subheader:Base
        title="{{ pageData.title }}"
        container="single-3"
        :breadcrumb="[{title: pageData.title}]"
    />

    <div class="container-single-3 mt-6 mb-20 lg:mt-14 lg:mb-30">
        <article class="wysiwyg wysiwyg-theme flex flex-col gap-10 min-w-0">
            {% if pageData.chapo %}
                <p class="paragraph-1">{{ pageData.chapo }}</p>
            {% endif %}

            <div>{{ pageData.description|raw }}</div>

            {{ pageHTML|raw }}
        </article>
    </div>
{% endblock %}
